&uart1 {
	status = "okay";
};

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <
                NRF_PSEL(SPIS_SCK,  0, 10)
                NRF_PSEL(SPIS_MOSI, 0, 11)
                NRF_PSEL(SPIS_MISO, 0, 12)
                NRF_PSEL(SPIS_CSN,  0, 13)
            >;
        };
    };
};

&spi2 {
    compatible = "nordic,nrf-spis";
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-names = "default";
    def-char = <0xFF>; 
};

/ {
    aliases {
        drdy-pin = &drdy_out;
    };

    outputs {
        compatible = "gpio-leds";
        drdy_out: drdy_out {
            /* Adjust the pin number to whichever nRF pin you are using */
            gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
            label = "Data Ready Output Pin";
        };
    };
};