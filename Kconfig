menu "TDMA link"

choice
	prompt "TDMA role"
	default TDMA_ROLE_MASTER
	help
	  Which end of the link this image is. The master owns the time base and
	  transmits unconditionally; the slave acquires the master's grid and
	  tracks its clock. Both use the same schedule; only the source of the
	  epoch differs.

config TDMA_ROLE_MASTER
	bool "Master (owns the time base)"

config TDMA_ROLE_SLAVE
	bool "Slave (synchronizes to the master)"

endchoice

endmenu

config CARRIER
	int "Carrier to use"
	default 0
	help
	   The availability of the channels and the exact regulation to use them varies in different countries.
	   See ETSI TS 103 636-2 5.4.2 for the calculation.
	   Band index 1 is set when the carrier is within the range of 525 to 551.
	   This is the only range allowed for band index 1 as other carriers will interfere with other radio devices, including LTE devices.

config NETWORK_ID
	int "Network ID"
	range 1 4294967295
	default 91

config MCS
	int "MCS"
	default 1
	help
	   The MCS impacts how much data can fit into each subslot. prj.conf sets 4.

config TX_POWER
	int "TX power"
	range 0 13
	default 13
	help
	   Transmission power index.
	   See table 6.2.1-3 of ETSI TS 103 636-4 v1.5.1.

menu "Zephyr Kernel"
source "Kconfig.zephyr"
endmenu
