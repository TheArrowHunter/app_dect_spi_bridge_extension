#include <samples/cellular/nrf91_no_bootloader_partitions.dtsi>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

/delete-node/ &sram0_s;
/delete-node/ &sram0_ns;

&sram0 {
	/*
	 * 0x2000_0000  Secure RAM                      (   32 kB)
	 * 0x2000_8000  Non-secure RAM area             (  224 kB)
	 *   0x2000_8000  Modem shared area             ( 23336 B)
	 *     0x2000_8000  control                     (  1832 B)
	 *     0x2000_8728  app -> cell                 (   15 kB)
	 *     0x2000_c328  cell -> app                 (    6 kB)
	 *   0x2000_db28  Application RAM               (206040 B)
	 */
	sram0_s: sram@0 {
		reg = <0x0 0x8000>;
	};

	sram0_ns: sram@8000 {
		reg = <0x8000 0x38000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x8000 0x38000>;

		/* Must be in first 128 kB of RAM. */
		sram0_ns_modem: sram0_ns@0 {
			/* Modem (shared) memory */
			reg = <0x0 0x5b28>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x0 0x5b28>;

			cpuapp_cpucell_ipc_shm_ctrl: sram0_ns_modem@0 {
				/* Modem IPC control */
				reg = <0x0 0x728>;
			};

			cpuapp_cpucell_ipc_shm_heap: sram0_ns_modem@728 {
				/* Modem IPC transmit */
				reg = <0x728 0x3c00>;
			};

			cpucell_cpuapp_ipc_shm_heap: sram0_ns_modem@4328 {
				/* Modem IPC receive */
				reg = <0x4328 0x1800>;
			};
		};

		sram0_ns_app: sram0_ns@5b28 {
			/* Non-Secure application memory */
			reg = <0x5b28 0x324d8>;
		};
	};
};

&uart1 {
	status = "okay";
};

&pinctrl {
    spi2_default: spi2_default {
        group1 {
            psels = <
                NRF_PSEL(SPIS_SCK,  0, 10)
                NRF_PSEL(SPIS_MOSI, 0, 11)
                NRF_PSEL(SPIS_MISO, 0, 12)
                NRF_PSEL(SPIS_CSN,  0, 13)
            >;
            nordic,drive-mode = <NRF_DRIVE_H0H1>;
        };
    };
};

spi_slave: &spi2 {
    compatible = "nordic,nrf-spis";
    status = "okay";
    pinctrl-0 = <&spi2_default>;
    pinctrl-names = "default";
    def-char = <0xFF>;
};

/ {
    zephyr,user {
        /* Raw outputs for high-speed handshake */
        spi-req-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
        spi-rdy-gpios = <&gpio0 8 GPIO_ACTIVE_HIGH>;
    };
};
